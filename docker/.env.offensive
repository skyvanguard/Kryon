# =============================================================================
# KRYON — Perfil OFENSIVO (DeepSeek API)
# =============================================================================
# Para targets NO-banca: CTF, labs, bug-bounty con autorización escrita, research.
# NUNCA usar contra un cliente bancario con datos reales (los datos del target
# salen a DeepSeek). Para banca usar docker/.env.docker (perfil local llama.cpp).
#
# Uso (las vars de interpolación las toma el bloque environment del compose):
#   export DEEPSEEK_API_KEY=sk-...        # tu key (NO commitear)
#   docker compose --env-file docker/.env.offensive \
#     -f docker/docker-compose.kali.yml up -d
# =============================================================================

# LLM principal — DeepSeek (OpenAI-compatible, native tool-calling).
OPENAI_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_BASE_URL=https://api.deepseek.com/v1
KRYON_MODEL=deepseek-chat
# DeepSeek hace native tool-calling fiable: no necesita los parsers locales
# ni forzar tool_choice los primeros turnos.
KRYON_LOCAL_LLM=false
KRYON_FORCE_TOOL_TURNS=0

# Secundarios al mismo modelo barato.
KRYON_TRIAGE_MODEL=deepseek-chat
KRYON_COMPLIANCE_NARRATOR_MODEL=deepseek-chat
KRYON_RAG_MODEL=deepseek-chat
KRYON_GUARDRAIL_MODEL=deepseek-chat

# Perfil ofensivo: red-team ON, RAG/memory off.
KRYON_RED_TEAM=true
KRYON_PHASE_TURNS=10
# Guard-rails de gasto (F1.5) — protegen el saldo de la API en runs largos:
#   KRYON_MAX_TURNS    cap de turnos del ReAct loop de `investigate`
#   KRYON_WALL_BUDGET_S corta el loop si excede N segundos (0 = sin límite)
KRYON_MAX_TURNS=8
KRYON_WALL_BUDGET_S=600
KRYON_MEMORY=false
KRYON_AUTO_UPDATE=false
# F5 — EFE planner (experimental, OFF por default). El planner elige la próxima
# acción por Expected Free Energy (acercarse al objetivo + reducir incertidumbre
# del target) en vez de first-match. Activar SOLO para benchear si mejora el pwn:
#   KRYON_EFE_PLANNER=true
#   KRYON_EFE_EPISTEMIC_WEIGHT=1.5
