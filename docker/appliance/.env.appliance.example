# =============================================================================
# KRYON Appliance — plantilla de configuración
# =============================================================================
# NO edites este archivo con tus claves. Corré ./setup.sh, que genera
# .env.appliance (este .example es solo la referencia). Nunca commitees el
# .env.appliance real (tiene secretos).
# =============================================================================

# --- Cerebro central (TU server de inferencia) ------------------------------
# El appliance NO corre el LLM: lo consume por HTTP desde tu server.
OPENAI_BASE_URL=http://llm-server:8080/v1
OPENAI_API_KEY=llama
KRYON_MODEL=qwen-unc
KRYON_LOCAL_LLM=true

# --- Identidad del agente (v2.x unified) ------------------------------------
KRYON_UNIFIED=true
KRYON_AGENT_TYPE=kryon

# --- Seguridad del appliance ------------------------------------------------
# setup.sh genera estas dos. La API key es la que el cliente ingresa en el
# dashboard; el JWT secret firma las sesiones de login multi-usuario.
KRYON_API_KEY=CHANGEME_generado_por_setup
KRYON_JWT_SECRET=CHANGEME_generado_por_setup

# Puerto donde el cliente abre el dashboard (http://<mini-pc>:8700/)
KRYON_PORT=8700

# --- Ventana de contexto del modelo activo (evita mal auto-compact) ----------
# qwen-unc (Qwen3-Next-80B) = 262144 (256K). Ajustar si cambia el modelo central.
KRYON_MODEL_MAX_TOKENS=262144

# --- Identidad del cliente (para reportes / multi-tenant) -------------------
KRYON_CLIENT_NAME=cliente

# --- Estabilidad ------------------------------------------------------------
KRYON_STREAM=false
KRYON_MEMORY=false
