# =============================================================================
# KRYON - Docker Environment EXAMPLE
# Copy to .env.docker and fill in real values. .env.docker is .gitignored.
#   cp docker/.env.docker.example docker/.env.docker
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider — DeepSeek API (default for v2.1+)
# -----------------------------------------------------------------------------
# Get an API key at: https://platform.deepseek.com/api_keys
# Pricing: $0.14 / $0.0028 (cache hit) / $0.28 per 1M tokens
# Costo ref Britimp full audit: ~$0.22 con cache hit ~70%.
#
# Two ways to provide the key:
#   1) Hardcode here (this file is gitignored): OPENAI_API_KEY=sk-xxxxx
#   2) Reference a shell var (preferred): OPENAI_API_KEY=${DEEPSEEK_API_KEY}
#      and `export DEEPSEEK_API_KEY=sk-xxxxx` before launching kryon
OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-DEEPSEEK-KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1
OLLAMA=false

# Modelo principal — V4 Flash con thinking ON (alias vigente hasta 2026-07-24).
# 1M context, 384K max output, native tool calling.
KRYON_MODEL=deepseek-reasoner

# Modelos secundarios — sin thinking, más baratos y rápidos.
KRYON_TRIAGE_MODEL=deepseek-chat
KRYON_COMPLIANCE_NARRATOR_MODEL=deepseek-chat
KRYON_RAG_MODEL=deepseek-chat
KRYON_GUARDRAIL_MODEL=deepseek-chat

# --- Alternative: local Ollama (uncomment block below + comment DeepSeek above) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# OLLAMA=true
# KRYON_MODEL=kryon-14b
# KRYON_FORCE_TOOL_TURNS=8

# --- Alternative: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA=false
# KRYON_MODEL=gpt-4o

# --- Alternative: Anthropic via LiteLLM ---
# OPENAI_API_KEY=sk-ant-...
# OLLAMA=false
# KRYON_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# KRYON Core Configuration
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

KRYON_AGENT=kryon
KRYON_AGENT_TYPE=kryon
KRYON_UNIFIED=true
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
# DeepSeek API does native tool calling reliably; no need to force tool_choice.
# Set to 0 for API providers; bump to 8 only when running local Ollama models.
KRYON_FORCE_TOOL_TURNS=0
KRYON_PARALLEL=1
# Hard budget cap in USD; "inf" disables. Useful for client engagements.
# Example: KRYON_PRICE_LIMIT=2.00 aborts the session when running cost
# exceeds $2.00 (prevents runaway loops from billing surprise).
KRYON_PRICE_LIMIT=inf

# Persist message_history every N adds to ~/.kryon/sessions/<id>/checkpoint.json
# so DeepSeek 5xx / network drops don't wipe findings mid-audit. 0 disables.
KRYON_CHECKPOINT_EVERY=50

KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG (embeddings stay local — DeepSeek has no first-class embeddings)
# -----------------------------------------------------------------------------
KRYON_MEMORY=true
KRYON_AUTO_UPDATE=true
KRYON_EMBEDDING_MODEL=nomic-embed-text
KRYON_EMBEDDING_BASE_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# CTF / Pentesting (per-engagement; uncomment as needed)
# -----------------------------------------------------------------------------
# TARGET=10.10.10.1
# CTF_NAME=HackTheBox
# CTF_INSIDE=true
# SSH_USER=
# SSH_HOST=

# -----------------------------------------------------------------------------
# Server & Auth (uncomment if exposing the FastAPI port)
# -----------------------------------------------------------------------------
# JWT_SECRET=change-me-to-a-random-string
# KRYON_API_KEY=change-me-to-a-random-key
# KRYON_RATE_LIMIT=60
# KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
