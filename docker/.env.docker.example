# =============================================================================
# KRYON - Docker Environment Configuration (Kali + Ollama)
# =============================================================================
# Copy to .env.docker and customize:
#   cp docker/.env.docker.example docker/.env.docker
#
# NEVER commit .env.docker to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider — Ollama (local, GPU-accelerated)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA=true

# Primary model (must be pulled first: docker exec kryon-ollama ollama pull qwen2.5:7b)
KRYON_MODEL=qwen2.5:7b

# --- Alternative: Cloud providers (uncomment ONE block) ---
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA=false
# KRYON_MODEL=gpt-4o

# Anthropic (via litellm)
# OPENAI_API_KEY=sk-ant-...
# OLLAMA=false
# KRYON_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# KRYON Core Configuration
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

# Agent defaults
KRYON_AGENT=recon_scout
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
KRYON_PARALLEL=1
KRYON_PRICE_LIMIT=inf

# Workspace (inside container)
KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG
# -----------------------------------------------------------------------------
KRYON_MEMORY=false
KRYON_MEMORY_ONLINE=false
KRYON_MEMORY_OFFLINE=false

# ChromaDB persistence (embedded, mounted volume)
# No external service needed — uses PersistentClient

# -----------------------------------------------------------------------------
# CTF / Pentesting Configuration
# -----------------------------------------------------------------------------
# TARGET=10.10.10.1
# CTF_NAME=HackTheBox
# CTF_CHALLENGE=machine-name
# CTF_SUBNET=10.10.10.0/24
# CTF_IP=10.10.14.50
# CTF_INSIDE=true

# SSH target (for agents that use SSH)
# SSH_USER=
# SSH_HOST=
# SSH_PASS=

# -----------------------------------------------------------------------------
# Server & Auth
# -----------------------------------------------------------------------------
# JWT_SECRET=change-me-to-a-random-string
# KRYON_API_KEY=change-me-to-a-random-key

# Rate limiting
# KRYON_RATE_LIMIT=60

# CORS origins (comma-separated)
# KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Claude Code CLI (for hybrid delegation)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
