# =============================================================================
# KRYON - Docker Environment (local, reusa Ollama del host)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Ollama en contenedor (servicio `ollama` de la misma red compose)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA=true

# Modelo principal: kryon-14b (alias de Qwen3-14B denso, Q4_K_M)
# 14.8B parámetros densos — todos activos por token. Cabe 100% en 12GB VRAM.
# Contexto: 32K (baked-in via Modelfile). Nativo 128K — subir si hay VRAM.
# Tool calling nativo. BFCL v3: 70.8 (supera Qwen3-32B en tool-use por balance).
# Benchmark Juice Shop: 9/111 (8.1%) vs kryon-30b-moe 0/111.
#
# Alias anterior kryon-30b-moe (Qwen3-Coder-30B-A3B MoE) movió a deprecated:
# 3.3B activos + 18GB Q4 → spillover VRAM → 30× más lento + 0% agentic.
KRYON_MODEL=kryon-14b

# -----------------------------------------------------------------------------
# KRYON Core
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

KRYON_AGENT=kryon
KRYON_AGENT_TYPE=kryon
KRYON_UNIFIED=true
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
KRYON_FORCE_TOOL_TURNS=8
KRYON_PARALLEL=1
KRYON_PRICE_LIMIT=inf

KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG (usa nomic-embed-text del host Ollama)
# -----------------------------------------------------------------------------
KRYON_MEMORY=true
KRYON_AUTO_UPDATE=true
KRYON_EMBEDDING_MODEL=nomic-embed-text
KRYON_EMBEDDING_BASE_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# Server & Auth (genera tus propios secretos si expones el puerto)
# -----------------------------------------------------------------------------
JWT_SECRET=local-dev-change-me-before-exposing
KRYON_API_KEY=local-dev-change-me-before-exposing
KRYON_RATE_LIMIT=60
KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
