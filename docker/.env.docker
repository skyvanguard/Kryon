# =============================================================================
# KRYON - Docker Environment (llama.cpp local — Kryon-MOE-35B, sin Ollama)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — DeepSeek API (V4 Flash con thinking via alias deepseek-reasoner)
# -----------------------------------------------------------------------------
# Pasar la API key por shell o --env-file (no commitear). Crear en:
#   https://platform.deepseek.com/api_keys
# Costo ref Britimp full audit: ~$3.45 con cache hit ~80%.
# --- LLM principal: MoE Kryon-MOE-35B (Qwen3.6-35B-A3B UD-Q4_K_XL) vía llama.cpp ---
# Servicio `llama-server` del compose. NOTA: para estas 4 vars el bloque
# `environment:` del compose PISA este env_file — quedan acá por consistencia
# y para uso fuera de docker. Rollback DeepSeek: comentar las de llama.cpp,
# descomentar las 2 siguientes y revertir el bloque environment del compose.
# OPENAI_API_KEY=${DEEPSEEK_API_KEY}
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=llama
OPENAI_BASE_URL=http://llama-server:8080/v1
# Modo LLM local OpenAI-compat (parsers robustos + usage patch para llama.cpp).
# Reemplaza al viejo flag OLLAMA — mismo comportamiento, sin atar a Ollama.
KRYON_LOCAL_LLM=true

# Modelo principal — V4 Flash con thinking ON (alias vigente hasta 2026-07-24).
# Después usar nombre bare: deepseek-v4-flash + thinking flag en request.
# 1M context, 384K max output, native tool calling, reasoning_effort=low.
# KRYON_MODEL=deepseek-reasoner    # rollback DeepSeek
KRYON_MODEL=Kryon-MOE-35B          # alias del MoE en llama-server (-a Kryon-MOE-35B)

# Modelos secundarios — sin thinking, más baratos y rápidos.
# Triage de findings + narrador compliance + RAG generation + injection guardrail
# no necesitan reasoning chains; todos comparten OPENAI_BASE_URL/API_KEY.
# Secundarios desactivados → caen al modelo principal (MoE). Antes: deepseek-chat.
KRYON_TRIAGE_MODEL=Kryon-MOE-35B
KRYON_COMPLIANCE_NARRATOR_MODEL=Kryon-MOE-35B
KRYON_RAG_MODEL=Kryon-MOE-35B
KRYON_GUARDRAIL_MODEL=Kryon-MOE-35B

# -----------------------------------------------------------------------------
# KRYON Core
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

KRYON_AGENT=kryon
KRYON_AGENT_TYPE=kryon
KRYON_UNIFIED=true
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
# DeepSeek API does native tool calling reliably; no need to force tool_choice.
# Set to 0 for API providers; bump to 8 only when running local Ollama models.
KRYON_FORCE_TOOL_TURNS=8
KRYON_PARALLEL=1
KRYON_PRICE_LIMIT=inf

KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG — APAGADO (sin Ollama, sin embeddings). El RAG estaba
# infrautilizado: corpus 94% duplicado, query_knowledge_base con 0 llamadas
# reales, search_vulnerabilities siempre count:0. Las tools de RAG se quitaron
# del tool budget. Sin KRYON_EMBEDDING_BASE_URL no hay dependencia de Ollama.
# -----------------------------------------------------------------------------
KRYON_MEMORY=false
KRYON_AUTO_UPDATE=false

# -----------------------------------------------------------------------------
# Server & Auth (genera tus propios secretos si expones el puerto)
# -----------------------------------------------------------------------------
JWT_SECRET=local-dev-change-me-before-exposing
KRYON_API_KEY=local-dev-change-me-before-exposing
KRYON_RATE_LIMIT=60
KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
