# =============================================================================
# KRYON - Docker Environment (local, reusa Ollama del host)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Ollama en contenedor (servicio `ollama` de la misma red compose)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA=true

# Modelo principal — F16 sprint: qwen3-coder A3B MoE (30B total, 3B active params).
# Elegido sobre gemma4:26b-32k por: (a) mejor en agent/tool-use benchmarks,
# (b) A3B da inferencia más rápida (solo 3B activos por token), (c) alineado
# con Transilience CommunityTools methodology que reportó 100% CTF en modelos
# similares con skills markdown. Ver docs/F16_PLAN.md.
KRYON_MODEL=hf.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M

# -----------------------------------------------------------------------------
# KRYON Core
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

KRYON_AGENT=kryon
KRYON_AGENT_TYPE=kryon
KRYON_UNIFIED=true
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
KRYON_FORCE_TOOL_TURNS=8
KRYON_PARALLEL=1
KRYON_PRICE_LIMIT=inf

KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG (usa nomic-embed-text del host Ollama)
# -----------------------------------------------------------------------------
KRYON_MEMORY=true
KRYON_AUTO_UPDATE=true
KRYON_EMBEDDING_MODEL=nomic-embed-text
KRYON_EMBEDDING_BASE_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# Server & Auth (genera tus propios secretos si expones el puerto)
# -----------------------------------------------------------------------------
JWT_SECRET=local-dev-change-me-before-exposing
KRYON_API_KEY=local-dev-change-me-before-exposing
KRYON_RATE_LIMIT=60
KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
