# =============================================================================
# KRYON - Docker Environment (Qwen3-Next-80B-A3B-Thinking local, fallback llama.cpp)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Qwen3-Next-80B-A3B-Thinking (primary, reasoning/agentic)
# -----------------------------------------------------------------------------
# Modelo activo: Qwen3-Next-80B-A3B-Thinking (IQ4_XS) vía llama-server (llama.cpp)
# en el server LLM (10.0.0.10), servido en el container `llm-server` bajo alias
# `qwen-unc` con `--reasoning-format deepseek`. Es un REASONING model (emite
# reasoning_content) — se eligió sobre el hermano Coder-Next (non-thinking) porque
# tiene AGENCIA: conduce las tools e itera sobre el feedback (validado en vivo:
# enumeró main.Users + columnas y lanzó el dump donde el Coder-Next se atascaba).
# Contrapartida: MUCHO más lento (~15K chars reasoning/turno) → necesita
# PRESERVE_REASONING + timeouts altos. El GGUF del Coder-Next sigue en disco
# (/models/Qwen3-Coder-Next/) por si se quiere el modo rápido-narrador.
# SSH access: user@llm-server (dentro de docker: llm-server:8080)
OPENAI_BASE_URL=http://llm-server:8080/v1
KRYON_MODEL=qwen-unc

# Fallback / swap-test: comentar arriba y descomentar
# OPENAI_BASE_URL=http://10.0.0.10:8080/v1   # acceso por IP (fuera de docker)
# KRYON_MODEL=kryon-devstral-24b

# Modo LLM local OpenAI-compat (parsers robustos + usage patch para llama.cpp).
KRYON_LOCAL_LLM=true

# Reasoner activo: preservar el reasoning en reasoning-only stops (respuesta en
# reasoning_content, content vacío) → promueve reasoning→content aun sin
# CAPABLE_MODEL, así la respuesta del Thinking sobrevive al reporte + historia.
# CRÍTICO con un thinking model: sin esto la respuesta se pierde/se fuerza a tool_call.
KRYON_PRESERVE_REASONING=true

# Modelos secundarios — caen al modelo principal (Qwen3-Next-Thinking).
KRYON_TRIAGE_MODEL=qwen-unc
KRYON_COMPLIANCE_NARRATOR_MODEL=qwen-unc
KRYON_RAG_MODEL=qwen-unc
KRYON_GUARDRAIL_MODEL=qwen-unc

# --- Context-window management / auto-compact --------------------------------
# El umbral de auto-compact es relativo a la ventana de contexto del modelo. Si
# Kryon no la conoce cae al default 200k → compacta a ~160k y tira ~84% del 1M
# de V4 Flash. Como KRYON_MODEL usa el alias neutral 'kryon-local' (que el
# resolver NO mapea a propósito, para no sobre-estimar un modelo chico swapeado),
# hay que declararla explícitamente aquí. El override SIEMPRE gana.
KRYON_MODEL_MAX_TOKENS=524288           # V4-Flash-0731 a 512K (server -c 524288, deben coincidir; antes 1M pero el server bajó a 512K por velocidad). Laguna era 256K (262144). deepseek-reasoner/chat = 128000
KRYON_AUTO_COMPACT=true                 # 'false' desactiva el resumen-LLM por umbral
KRYON_AUTO_COMPACT_THRESHOLD=0.8        # compacta cuando input tokens > 80% de la ventana
# Capas deterministas (sin LLM, banca-safe) — corren siempre, independientes del auto-compact:
KRYON_MICRO_COMPACT=false               # OFF con Laguna a 256K nativo: el budget 1000 (calibrado 4B) trituraba evidencia que el reasoner encadena. auto_compact queda de red de seguridad.
# KRYON_MAX_TOOL_RESULT — cap por resultado (>N chars → disco + preview). Ahora es
# RELATIVO a la ventana: 5k en ventana chica (4B), 50k en ventana grande (V4 1M),
# para no tirar la evidencia cruda que el modelo capaz encadena. NO lo fijes a 5000
# o pisás el default relativo y volvés a estrangular a V4. Descomentá solo para forzar.
# KRYON_MAX_TOOL_RESULT=5000

# --- Perfil CAPABLE (V4 Flash offensive) — descomentar para que V4 Flash DRIVE ---
# DEFAULT AHORA = capable/frontier. El régimen 4B fue RETIRADO (2026-07-31): el
# server corre reasoners capaces (Laguna 80B / DeepSeek V4-Flash), no el 4B-local.
# Capable flipa ~15 sitios IMPONE→SUGIERE — el modelo CONDUCE la kill-chain en vez
# de narrar el motor determinista (validado vivo: en 4B regime Laguna giraba en
# execute_planner_directive; en capable hace POST auth + guarda sesión solo).
# NOTA: rompe banca-safe (temp 0.4 no reproducible por hash + gates SUGGEST = más
# FPs) → runs de compliance/banca deben setear EXPLÍCITO KRYON_CAPABLE_MODEL=false.
KRYON_CAPABLE_MODEL=true                 # DEFAULT: ~15 sitios IMPONE→SUGIERE (el gran switch)
KRYON_REASONING_EFFORT=high              # V4-0731 al MAX: reasoner verboso (el thinking se come tokens) → requiere PRESERVE_REASONING=true + budgets altos. Bajá a medium/vacío si CoT loopea sin pre_hooks.
KRYON_PHASE_TURNS=10

# -----------------------------------------------------------------------------
# KRYON Core
# -----------------------------------------------------------------------------
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_STREAM=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

KRYON_AGENT=kryon
KRYON_AGENT_TYPE=kryon
KRYON_UNIFIED=true
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=50
# Qwen3-Coder-Next-80B does native tool calling reliably via --jinja; no need to force tool_choice.
# Sin setear: aplica el default capable-aware → 0 para capable (el modelo conduce solo; forzar
# disparaba tools espurias en requests triviales / "sin herramientas") y 8 para el 4B-local.
# Setear un valor (ej. 1) para re-imponer un nudge puntual.
# KRYON_FORCE_TOOL_TURNS=
KRYON_PARALLEL=1
KRYON_PRICE_LIMIT=inf

KRYON_WORKSPACE_DIR=/workspace

# -----------------------------------------------------------------------------
# Memory & RAG — APAGADO (sin Ollama, sin embeddings). El RAG estaba
# infrautilizado: corpus 94% duplicado, query_knowledge_base con 0 llamadas
# reales, search_vulnerabilities siempre count:0. Las tools de RAG se quitaron
# del tool budget. Sin KRYON_EMBEDDING_BASE_URL no hay dependencia de Ollama.
# -----------------------------------------------------------------------------
KRYON_MEMORY=false
KRYON_AUTO_UPDATE=false

# -----------------------------------------------------------------------------
# Server & Auth (genera tus propios secretos si expones el puerto)
# -----------------------------------------------------------------------------
JWT_SECRET=local-dev-change-me-before-exposing
KRYON_API_KEY=local-dev-change-me-before-exposing
KRYON_RATE_LIMIT=60
KRYON_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
