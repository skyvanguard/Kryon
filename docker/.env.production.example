# =============================================================================
# KRYON - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in your values.
# NEVER commit .env.production to version control!
# =============================================================================

# --- API Keys (Required: at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- LLM Configuration ---
KRYON_MODEL=gpt-4o
KRYON_SUPPORT_MODEL=o3-mini

# --- Agent Configuration ---
KRYON_AGENT=recon_scout
KRYON_GUARDRAILS=true
KRYON_MAX_TURNS=inf
KRYON_PARALLEL=1

# --- Debug & Logging ---
# 0: Only tool outputs, 1: Verbose, 2: CLI debug
KRYON_DEBUG=0
KRYON_BRIEF=false
KRYON_TRACING=false
KRYON_TELEMETRY=false

# --- Streaming ---
KRYON_STREAM=false

# --- Memory / RAG ---
KRYON_MEMORY=false
KRYON_MEMORY_ONLINE=false
KRYON_MEMORY_OFFLINE=false
KRYON_MEMORY_ONLINE_INTERVAL=5

# --- Cost Control ---
KRYON_PRICE_LIMIT=inf

# --- Workspace ---
# KRYON_WORKSPACE_DIR=/workspace
# KRYON_WORKSPACE=default

# --- CTF Configuration (optional) ---
# CTF_NAME=
# CTF_CHALLENGE=
# CTF_SUBNET=192.168.3.0/24
# CTF_IP=192.168.3.100
# CTF_INSIDE=true

# --- SSH Configuration (optional) ---
# SSH_USER=
# SSH_HOST=
# SSH_PASS=

# --- Docker Container Execution (optional) ---
# KRYON_ACTIVE_CONTAINER=

# --- ChromaDB (if using RAG profile) ---
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000
