# Build artifacts and dependency caches that should never enter the
# Docker build context. Keeping this minimal — the Dockerfile already
# filters what it copies, but excluding these speeds up `docker build`
# by ~10-30 seconds on a cold laptop.

node_modules
.next
out
.pnpm-store

# Local environment overrides (never pushed to images)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Git metadata
.git
.gitignore

# README and docs don't need to be in the runtime image
README.md
CHANGELOG.md
AGENTS.md
CLAUDE.md
