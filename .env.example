# =============================================================================
# KRYON - Autonomous Cybersecurity Intelligence Platform
# Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings
# Required fields are marked with [REQUIRED]
# =============================================================================

# =============================================================================
# QUICK START (Minimum configuration)
# =============================================================================

# [REQUIRED] Choose ONE AI provider and set its API key:

# Option A: OpenAI (recommended for beginners)
OPENAI_API_KEY="sk-your-openai-key-here"

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Option C: Local with Ollama (free, no API key needed)
# OLLAMA_API_BASE="http://localhost:11434/v1"

# =============================================================================
# BASIC SETTINGS
# =============================================================================

# AI Model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet, claude-3-opus, deepseek-chat
#          qwen2.5:14b (Ollama), llama3.1:70b (Ollama)
KRYON_MODEL="gpt-4o"

# Security Agent to deploy (default: recon_scout)
# Options: recon_scout       - Reconnaissance (default)
#          pentest_agent     - Penetration testing
#          vuln_hunter       - Bug bounty hunting
#          ctf_master        - CTF competitions
#          guardian_protocol - Defensive security
#          forensic_analyzer - Incident response
#          central_core      - Multi-agent orchestrator
KRYON_AGENT_TYPE="recon_scout"

# Enable security guardrails (ALWAYS keep true in production)
KRYON_GUARDRAILS="true"

# =============================================================================
# ENTERPRISE SETTINGS
# =============================================================================

# Disable telemetry for privacy (recommended for enterprises)
KRYON_TELEMETRY="false"

# Enable operation tracing (OpenTelemetry)
KRYON_TRACING="false"

# Maximum cost per session in USD (0 = unlimited)
KRYON_PRICE_LIMIT="10"

# Debug level: 0=minimal, 1=normal, 2=verbose
KRYON_DEBUG="0"

# Enable streaming output
KRYON_STREAM="true"

# =============================================================================
# ADDITIONAL AI PROVIDERS (Optional)
# =============================================================================

# DeepSeek (cost-effective alternative)
# DEEPSEEK_API_KEY="your-deepseek-key"

# OpenRouter (access to many models)
# OPENROUTER_API_KEY="your-openrouter-key"

# Azure OpenAI (enterprise)
# AZURE_API_KEY="your-azure-key"
# AZURE_API_BASE="https://your-resource.openai.azure.com"

# =============================================================================
# WORKSPACE & STORAGE
# =============================================================================

# Workspace directory for operation files
KRYON_WORKSPACE_DIR=".kryon"

# Default operational sector
KRYON_SECTOR="default"

# =============================================================================
# CTF MODE (Capture The Flag)
# =============================================================================

# CTF_NAME="hackthebox"
# CTF_CHALLENGE="machine_name"
# CTF_IP="10.10.10.1"
# CTF_SUBNET="10.10.10.0/24"

# =============================================================================
# KNOWLEDGE BASE & RAG
# =============================================================================
# Auto-seed: On first run, KRYON loads 13 static seed files (CVEs, OWASP,
# MITRE ATT&CK, etc.) into the vector DB. No configuration needed.

# Auto-updater: scrapes NVD, ExploitDB, GitHub daily for fresh CVEs/exploits
# KRYON_AUTO_UPDATE="true"

# =============================================================================
# CLAUDE CODE CLI BACKEND
# =============================================================================
# Use Claude Code CLI (requires Claude Pro Max subscription + `claude` binary)
# instead of API keys.  Launch with: kryon --claude-code

# Enable Claude Code CLI as default LLM backend
# KRYON_CLAUDE_CODE="true"

# Model to use — opus (default, best quality), sonnet (fast), haiku (fastest)
# KRYON_CLAUDE_MODEL="opus"

# =============================================================================
# BUG BOUNTY PLATFORMS (F65) — HackerOne integration
# =============================================================================
# Generate your API token at https://hackerone.com/settings/api
# NEVER commit the token. Keep this file template in the repo; your real
# values live in ~/.kryon/secrets.env (chmod 600) or equivalent.
#
# Once set, Kryon's run_web_pentest tool accepts hackerone_program_handle
# and validates target URLs against the program's structured_scopes
# BEFORE probing. Out-of-scope probing = H1 program ban + legal risk.

# HACKERONE_API_USERNAME="your-h1-api-identifier"
# HACKERONE_API_TOKEN="your-h1-api-token-never-commit"

# =============================================================================
# EXAMPLES
# =============================================================================
#
# 1. Basic penetration test:
#    kryon
#    > Scan target.com for vulnerabilities
#
# 2. Bug bounty with Claude:
#    KRYON_MODEL=claude-sonnet-4-20250514 KRYON_AGENT_TYPE=vuln_hunter kryon
#
# 3. Local AI with Ollama (no API costs):
#    OLLAMA_API_BASE=http://localhost:11434/v1 KRYON_MODEL=qwen2.5:14b kryon
#
# 4. Multi-agent swarm:
#    KRYON_SWARM_SIZE=3 kryon
#
# =============================================================================
