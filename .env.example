# =============================================================================
# SKYNET - Autonomous Cybersecurity Intelligence System
# Environment Configuration Example
# =============================================================================

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------

# Primary AI Model Provider
OPENAI_API_KEY="sk-your-openai-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
DEEPSEEK_API_KEY="your-deepseek-key"

# Ollama Configuration (Local Models)
OLLAMA_API_BASE="http://localhost:11434/v1"

# OpenRouter Configuration
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"

# Azure OpenAI Configuration
AZURE_API_KEY="your-azure-key"
AZURE_API_BASE="https://your-resource.openai.azure.com"

# -----------------------------------------------------------------------------
# SKYNET Core Configuration
# -----------------------------------------------------------------------------

# Primary AI model to use (examples: gpt-4o, claude-3-7-sonnet, deepseek-chat)
SKYNET_MODEL="gpt-4o"

# Default Terminator unit to deploy
SKYNET_CORE="t800_infiltrator"

# Enable operation tracing (OpenTelemetry)
SKYNET_TRACE="true"

# Enable defense protocols (security guardrails)
SKYNET_DEFENSE_PROTOCOLS="true"

# Maximum turns per operation
SKYNET_MAX_TURNS="inf"

# Debug level: 0=tool outputs only, 1=verbose, 2=CLI debug
SKYNET_DEBUG="1"

# Enable streaming output
SKYNET_STREAM="false"

# Brief mode (less verbose output)
SKYNET_BRIEF="false"

# Enable telemetry
SKYNET_TELEMETRY="true"

# Number of parallel Terminator units (swarm size)
SKYNET_SWARM_SIZE="1"

# Autonomous mode (requires less human approval)
SKYNET_AUTONOMOUS_MODE="false"

# -----------------------------------------------------------------------------
# Mission Configuration
# -----------------------------------------------------------------------------

# Mission type (recon, pentest, ctf, forensics)
SKYNET_MISSION=""

# Mission target
TARGET=""

# Operational sector/workspace
SKYNET_SECTOR="default"

# Workspace directory
SKYNET_WORKSPACE_DIR=".skynet"

# Environment context (include system info in prompts)
SKYNET_ENV_CONTEXT="true"

# -----------------------------------------------------------------------------
# Memory & Intelligence Configuration
# -----------------------------------------------------------------------------

# Memory mode: episodic, semantic, all, or false
SKYNET_MEMORY="false"

# Online memory updates
SKYNET_MEMORY_ONLINE="false"

# Offline memory processing
SKYNET_MEMORY_OFFLINE="false"

# Turns between online memory updates
SKYNET_MEMORY_ONLINE_INTERVAL="5"

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Price limit for operation (in dollars)
SKYNET_PRICE_LIMIT="1"

# Support agent model
SKYNET_SUPPORT_MODEL="o3-mini"

# Turns between support agent executions
SKYNET_SUPPORT_INTERVAL="5"

# Reporting mode (ctf, nis2, pentesting)
SKYNET_REPORT=""

# -----------------------------------------------------------------------------
# CTF/Target Configuration (Legacy compatibility maintained)
# -----------------------------------------------------------------------------

# CTF challenge name
CTF_NAME=""

# Specific challenge within CTF
CTF_CHALLENGE=""

# CTF network subnet
CTF_SUBNET="192.168.3.0/24"

# CTF container IP
CTF_IP="192.168.3.100"

# Attack from within container
CTF_INSIDE="true"

# Enable CTF hints
CTF_HINTS="false"

# -----------------------------------------------------------------------------
# Integration & Tools
# -----------------------------------------------------------------------------

# Perplexity API for enhanced web search
PERPLEXITY_API_KEY=""

# Custom OpenAI-compatible API
OPENAI_BASE_URL=""

# -----------------------------------------------------------------------------
# System Configuration
# -----------------------------------------------------------------------------

# Disable cursor position reporting (for some terminals)
PROMPT_TOOLKIT_NO_CPR=1

# -----------------------------------------------------------------------------
# Legacy Compatibility (maintained for backward compatibility)
# -----------------------------------------------------------------------------

# These will fall back to SKYNET_* equivalents if not set
SKYNET_MODEL="gpt-4o"
SKYNET_AGENT_TYPE="t800_infiltrator"
SKYNET_STREAM="false"
SKYNET_TRACING="true"
SKYNET_GUARDRAILS="true"

# =============================================================================
# Quick Start Examples:
# =============================================================================
#
# Basic penetration testing:
#   SKYNET_CORE=t800_infiltrator SKYNET_MODEL=gpt-4o skynet
#
# Bug bounty hunting:
#   SKYNET_CORE=t1000_hunter SKYNET_MODEL=claude-3-7-sonnet skynet
#
# Swarm attack (3 parallel units):
#   SKYNET_SWARM_SIZE=3 SKYNET_CORE=t800_infiltrator skynet
#
# CTF challenge:
#   CTF_NAME="hackthebox" SKYNET_CORE=t600_scout skynet
#
# Forensic analysis:
#   SKYNET_CORE=forensic_analyzer SKYNET_MODEL=o1-preview skynet
#
# =============================================================================
