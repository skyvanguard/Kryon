# =============================================================================
# KRYON - Autonomous Cybersecurity Intelligence Platform
# Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings
# Required fields are marked with [REQUIRED]
# =============================================================================

# =============================================================================
# QUICK START (Minimum configuration)
# =============================================================================

# [REQUIRED] Choose ONE AI provider and set its API key:

# Option A: OpenAI (recommended for beginners)
OPENAI_API_KEY="sk-your-openai-key-here"

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Option C: Local with Ollama (free, no API key needed)
# OLLAMA_API_BASE="http://localhost:11434/v1"

# =============================================================================
# BASIC SETTINGS
# =============================================================================

# AI Model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet, claude-3-opus, deepseek-chat
#          qwen2.5:14b (Ollama), llama3.1:70b (Ollama)
KRYON_MODEL="gpt-4o"

# Security Agent to deploy (default: t800_infiltrator)
# Options: t800_infiltrator  - Penetration testing
#          t1000_hunter      - Bug bounty hunting
#          t600_scout        - Reconnaissance
#          guardian_protocol - Defensive security
#          forensic_analyzer - Incident response
KRYON_CORE="t800_infiltrator"

# Enable security guardrails (ALWAYS keep true in production)
KRYON_GUARDRAILS="true"

# =============================================================================
# ENTERPRISE SETTINGS
# =============================================================================

# Disable telemetry for privacy (recommended for enterprises)
KRYON_TELEMETRY="false"

# Enable operation tracing (OpenTelemetry)
KRYON_TRACING="false"

# Maximum cost per session in USD (0 = unlimited)
KRYON_PRICE_LIMIT="10"

# Debug level: 0=minimal, 1=normal, 2=verbose
KRYON_DEBUG="0"

# Enable streaming output
KRYON_STREAM="true"

# =============================================================================
# ADDITIONAL AI PROVIDERS (Optional)
# =============================================================================

# DeepSeek (cost-effective alternative)
# DEEPSEEK_API_KEY="your-deepseek-key"

# OpenRouter (access to many models)
# OPENROUTER_API_KEY="your-openrouter-key"

# Azure OpenAI (enterprise)
# AZURE_API_KEY="your-azure-key"
# AZURE_API_BASE="https://your-resource.openai.azure.com"

# =============================================================================
# WORKSPACE & STORAGE
# =============================================================================

# Workspace directory for operation files
KRYON_WORKSPACE_DIR=".kryon"

# Default operational sector
KRYON_SECTOR="default"

# =============================================================================
# CTF MODE (Capture The Flag)
# =============================================================================

# CTF_NAME="hackthebox"
# CTF_CHALLENGE="machine_name"
# CTF_IP="10.10.10.1"
# CTF_SUBNET="10.10.10.0/24"

# =============================================================================
# EXAMPLES
# =============================================================================
#
# 1. Basic penetration test:
#    kryon
#    > Scan target.com for vulnerabilities
#
# 2. Bug bounty with Claude:
#    KRYON_MODEL=claude-3-5-sonnet KRYON_CORE=t1000_hunter kryon
#
# 3. Local AI with Ollama (no API costs):
#    OLLAMA_API_BASE=http://localhost:11434/v1 KRYON_MODEL=qwen2.5:14b kryon
#
# 4. Multi-agent swarm:
#    KRYON_SWARM_SIZE=3 kryon
#
# =============================================================================
