# =============================================================================
# KRYON - Autonomous Cybersecurity Intelligence System
# Environment Configuration Example
# =============================================================================

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------

# Primary AI Model Provider
OPENAI_API_KEY="sk-your-openai-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
DEEPSEEK_API_KEY="your-deepseek-key"

# Ollama Configuration (Local Models)
OLLAMA_API_BASE="http://localhost:11434/v1"

# OpenRouter Configuration
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"

# Azure OpenAI Configuration
AZURE_API_KEY="your-azure-key"
AZURE_API_BASE="https://your-resource.openai.azure.com"

# -----------------------------------------------------------------------------
# KRYON Core Configuration
# -----------------------------------------------------------------------------

# Primary AI model to use (examples: gpt-4o, claude-3-7-sonnet, deepseek-chat)
KRYON_MODEL="gpt-4o"

# Default Terminator unit to deploy
KRYON_CORE="t800_infiltrator"

# Enable operation tracing (OpenTelemetry)
KRYON_TRACE="true"

# Enable defense protocols (security guardrails)
KRYON_DEFENSE_PROTOCOLS="true"

# Maximum turns per operation
KRYON_MAX_TURNS="inf"

# Debug level: 0=tool outputs only, 1=verbose, 2=CLI debug
KRYON_DEBUG="1"

# Enable streaming output
KRYON_STREAM="false"

# Brief mode (less verbose output)
KRYON_BRIEF="false"

# Enable telemetry
KRYON_TELEMETRY="true"

# Number of parallel Terminator units (swarm size)
KRYON_SWARM_SIZE="1"

# Autonomous mode (requires less human approval)
KRYON_AUTONOMOUS_MODE="false"

# -----------------------------------------------------------------------------
# Mission Configuration
# -----------------------------------------------------------------------------

# Mission type (recon, pentest, ctf, forensics)
KRYON_MISSION=""

# Mission target
TARGET=""

# Operational sector/workspace
KRYON_SECTOR="default"

# Workspace directory
KRYON_WORKSPACE_DIR=".kryon"

# Environment context (include system info in prompts)
KRYON_ENV_CONTEXT="true"

# -----------------------------------------------------------------------------
# Memory & Intelligence Configuration
# -----------------------------------------------------------------------------

# Memory mode: episodic, semantic, all, or false
KRYON_MEMORY="false"

# Online memory updates
KRYON_MEMORY_ONLINE="false"

# Offline memory processing
KRYON_MEMORY_OFFLINE="false"

# Turns between online memory updates
KRYON_MEMORY_ONLINE_INTERVAL="5"

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Price limit for operation (in dollars)
KRYON_PRICE_LIMIT="1"

# Support agent model
KRYON_SUPPORT_MODEL="o3-mini"

# Turns between support agent executions
KRYON_SUPPORT_INTERVAL="5"

# Reporting mode (ctf, nis2, pentesting)
KRYON_REPORT=""

# -----------------------------------------------------------------------------
# CTF/Target Configuration (Legacy compatibility maintained)
# -----------------------------------------------------------------------------

# CTF challenge name
CTF_NAME=""

# Specific challenge within CTF
CTF_CHALLENGE=""

# CTF network subnet
CTF_SUBNET="192.168.3.0/24"

# CTF container IP
CTF_IP="192.168.3.100"

# Attack from within container
CTF_INSIDE="true"

# Enable CTF hints
CTF_HINTS="false"

# -----------------------------------------------------------------------------
# Integration & Tools
# -----------------------------------------------------------------------------

# Perplexity API for enhanced web search
PERPLEXITY_API_KEY=""

# Custom OpenAI-compatible API
OPENAI_BASE_URL=""

# -----------------------------------------------------------------------------
# System Configuration
# -----------------------------------------------------------------------------

# Disable cursor position reporting (for some terminals)
PROMPT_TOOLKIT_NO_CPR=1

# -----------------------------------------------------------------------------
# Legacy Compatibility (maintained for backward compatibility)
# -----------------------------------------------------------------------------

# These will fall back to KRYON_* equivalents if not set
KRYON_MODEL="gpt-4o"
KRYON_AGENT_TYPE="t800_infiltrator"
KRYON_STREAM="false"
KRYON_TRACING="true"
KRYON_GUARDRAILS="true"

# =============================================================================
# Quick Start Examples:
# =============================================================================
#
# Basic penetration testing:
#   KRYON_CORE=t800_infiltrator KRYON_MODEL=gpt-4o kryon
#
# Bug bounty hunting:
#   KRYON_CORE=t1000_hunter KRYON_MODEL=claude-3-7-sonnet kryon
#
# Swarm attack (3 parallel units):
#   KRYON_SWARM_SIZE=3 KRYON_CORE=t800_infiltrator kryon
#
# CTF challenge:
#   CTF_NAME="hackthebox" KRYON_CORE=t600_scout kryon
#
# Forensic analysis:
#   KRYON_CORE=forensic_analyzer KRYON_MODEL=o1-preview kryon
#
# =============================================================================
